                        Visibility="Collapsed">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon
                                Glyph="&#xE8E5;"
                                FontSize="34"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
