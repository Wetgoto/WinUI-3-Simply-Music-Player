<Window
    x:Class="Music.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Music.Models"
    xmlns:local="using:Music"
    Title="Music">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!--
                Text that is too long for its slot scrolls horizontally instead
                of being cut off with an ellipsis. The ScrollViewer hides its
                bars; motion is driven by the shared marquee helpers in code.
            -->
            <Style x:Key="MarqueeTextStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="QueueActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style
                x:Key="SidebarSubNavButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource SidebarNavButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="36,0,12,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style
                x:Key="SidebarPlaylistButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource SidebarNavButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,1" />
            </Style>

            <Style x:Key="SidebarAddPlaylistButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MaxHeight" Value="34" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="AddPlaylistRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="AddPlaylistHover"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="AddPlaylistHover"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.06"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="AddPlaylistHover"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.16"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="AddPlaylistHover"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border
                                    x:Name="AddPlaylistHover"
                                    Background="Black"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Opacity="0" />

                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarSectionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Shared look for every track list: default list, recent, custom playlists. -->
            <Style x:Key="TrackRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid
                                x:Name="ItemRoot"
                                Background="Transparent"
                                CornerRadius="10">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="HoverLayer"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SelectionIndicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.08" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border
                                    x:Name="HoverLayer"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Opacity="0" />

                                <Border
                                    x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="40"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed"
                                    Opacity="0" />

                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Padding="{TemplateBinding Padding}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TrackRowTemplate" x:DataType="models:Track">
                <Grid
                    Padding="10,6"
                    ColumnSpacing="10"
                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind QueueTitle, Mode=OneWay}"
                    AutomationProperties.HelpText="{x:Bind DetailsLine, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.ColumnSpan="4"
                        Margin="-10,-6,-10,-6"
                        CornerRadius="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind CurrentVisibility, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <Border
                        Width="3"
                        Height="40"
                        Margin="-5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind CurrentVisibility, Mode=OneWay}"
                        IsHitTestVisible="False" />

                    <Grid
                        Grid.Column="0"
                        Width="56"
                        Height="56">
                        <Border
                            CornerRadius="10"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <FontIcon
                            Glyph="&#xE8D6;"
                            FontSize="22"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                        <Border
                            CornerRadius="10"
                            Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}">
                            <Border.Background>
                                <ImageBrush
                                    ImageSource="{x:Bind Artwork, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <ScrollViewer
                            HorizontalScrollMode="Enabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            IsTabStop="False"
                            AutomationProperties.HelpText="MarqueeScroll"
                            SizeChanged="Marquee_SizeChanged">
                            <TextBlock Text="{x:Bind QueueTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" HorizontalAlignment="Left" IsTextSelectionEnabled="False" />
                        </ScrollViewer>
                        <ScrollViewer
                            HorizontalScrollMode="Enabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Hidden"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            IsTabStop="False"
                            AutomationProperties.HelpText="MarqueeScroll"
                            SizeChanged="Marquee_SizeChanged">
                            <TextBlock Text="{x:Bind RecentSubtitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" HorizontalAlignment="Left" IsTextSelectionEnabled="False" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel
                        x:Name="QueueActionsPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <Button
                            Tag="local:LocalizedTag(Text='播放', English='Play')"
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueuePlayButton_Click"
                            ToolTipService.ToolTip="播放"
                            AutomationProperties.Name="播放">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                        </Button>
                        <Button
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueueFavoriteButton_Click"
                            ToolTipService.ToolTip="{x:Bind FavoriteToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind FavoriteToolTip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="13" />
                        </Button>
                        <Button
                            Tag="local:LocalizedTag(Text='添加到播放列表', English='Add to playlist')"
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueueAddButton_Click"
                            ToolTipService.ToolTip="添加到播放列表"
                            AutomationProperties.Name="添加到播放列表">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>
                        <Button
                            Tag="local:LocalizedTag(Text='更多选项', English='More options')"
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueueMoreButton_Click"
                            ToolTipService.ToolTip="更多选项"
                            AutomationProperties.Name="更多选项">
                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        Spacing="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind DurationText, Mode=OneWay}"
                            FontSize="14"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind FileInfoText, Mode=OneWay}"
                            FontSize="11"
                            HorizontalAlignment="Right"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Search results keep the same row rhythm, with the source playlists on the right. -->
            <DataTemplate x:Key="SearchRowTemplate" x:DataType="models:SearchResult">
                <Grid
                    Padding="10,6"
                    ColumnSpacing="10"
                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind QueueTitle, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.ColumnSpan="4"
                        Margin="-10,-6,-10,-6"
                        CornerRadius="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Visibility="{x:Bind Track.CurrentVisibility, Mode=OneWay}"
                        IsHitTestVisible="False" />
                    <Border
                        Width="3"
                        Height="40"
                        Margin="-5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind Track.CurrentVisibility, Mode=OneWay}"
                        IsHitTestVisible="False" />

                    <Grid
                        Grid.Column="0"
                        Width="56"
                        Height="56">
                        <Border
                            CornerRadius="10"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <FontIcon
                            Glyph="&#xE8D6;"
                            FontSize="22"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                        <Border
                            CornerRadius="10"
                            Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}">
                            <Border.Background>
                                <ImageBrush
                                    ImageSource="{x:Bind Artwork, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind QueueTitle, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            Text="{x:Bind Subtitle, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                    </StackPanel>

                    <StackPanel
                        x:Name="QueueActionsPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <Button
                            Tag="local:LocalizedTag(Text='播放', English='Play')"
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueuePlayButton_Click"
                            ToolTipService.ToolTip="播放"
                            AutomationProperties.Name="播放">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                        </Button>
                        <Button
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueueFavoriteButton_Click"
                            ToolTipService.ToolTip="{x:Bind Track.FavoriteToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Track.FavoriteToolTip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind Track.FavoriteGlyph, Mode=OneWay}" FontSize="13" />
                        </Button>
                        <Button
                            Tag="local:LocalizedTag(Text='添加到播放列表', English='Add to playlist')"
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueueAddButton_Click"
                            ToolTipService.ToolTip="添加到播放列表"
                            AutomationProperties.Name="添加到播放列表">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>
                        <Button
                            Tag="local:LocalizedTag(Text='更多选项', English='More options')"
                            Style="{StaticResource QueueActionButtonStyle}"
                            Click="QueueMoreButton_Click"
                            ToolTipService.ToolTip="更多选项"
                            AutomationProperties.Name="更多选项">
                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        Spacing="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind TrailingText, Mode=OneWay}"
                            FontSize="14"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind SourceText}"
                            FontSize="11"
                            HorizontalAlignment="Right"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#147B61FF" Offset="0" />
                <GradientStop Color="#00000000" Offset="0.45" />
                <GradientStop Color="#0C38BDF8" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="ImportAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="PlayPauseAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: back button, app identity, drag area -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="40"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <Button
                Tag="local:LocalizedTag(Text='返回', English='Back')"
                x:Name="BackButton"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="0"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                Click="BackButton_Click"
                ToolTipService.ToolTip="返回"
                AutomationProperties.Name="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="17" />
            </Button>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Background="Transparent">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                    <Border
                        Width="22"
                        Height="22"
                        CornerRadius="7"
                        Background="White">
                        <TextBlock
                            Text="♪"
                            FontFamily="Segoe UI Symbol"
                            FontSize="14"
                            Foreground="#111111"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,-2,0,0" />
                    </Border>
                    <TextBlock
                        Text="Simple Music Player"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Left navigation rail -->
        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="12,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App identity -->
                <Grid
                    x:Name="BrandArea"
                    Grid.Row="0"
                    Height="72"
                    Padding="4,10,4,0"
                    Background="Transparent">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="12"
                            Background="White">
                            <TextBlock
                                Text="♪"
                                FontFamily="Segoe UI Symbol"
                                FontSize="25"
                                Foreground="#111111"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,-3,0,0" />
                        </Border>
                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="1"
                            MaxWidth="176">
                            <TextBlock
                                Text="Simple Music Player"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Tag="local:LocalizedTag(Text='本地音乐', English='Local music')"
                                Text="本地音乐"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Global search entry -->
                <AutoSuggestBox
                    Tag="local:LocalizedTag(Text='搜索全部音乐', English='Search all music')"
                    x:Name="SidebarSearchBox"
                    Grid.Row="1"
                    Height="36"
                    Margin="0,0,0,4"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="12"
                    CornerRadius="8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    PlaceholderText="搜索全部音乐"
                    QueryIcon="Find"
                    TextChanged="SidebarSearchBox_TextChanged"
                    KeyDown="SidebarSearchBox_KeyDown"
                    AutomationProperties.Name="搜索所有播放列表" />

                <!-- Navigation tabs -->
                <ScrollViewer
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="1">
                        <Button
                            x:Name="PlayerNavButton"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="recent"
                            Click="SidebarNavButton_Click"
                            AutomationProperties.Name="最近的项目">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81C;" FontSize="16" />
                                <TextBlock Text="最近的项目" FontSize="13" FontWeight="SemiBold" Tag="local:LocalizedTag(Text='最近的项目', English='Recently played')" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="FavoritesNavButton"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="favorites"
                            Click="SidebarNavButton_Click"
                            AutomationProperties.Name="收藏的项目">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE734;" FontSize="16" />
                                <TextBlock Text="收藏的项目" FontSize="13" FontWeight="SemiBold" Tag="local:LocalizedTag(Text='收藏的项目', English='Favorites')" />
                            </StackPanel>
                        </Button>

                        <Button
                            Tag="local:LocalizedTag(Text='播放列表', English='Playlists')"
                            x:Name="PlaylistSectionButton"
                            Style="{StaticResource SidebarSectionButtonStyle}"
                            Click="TogglePlaylistSection"
                            AutomationProperties.Name="播放列表">
                            <Grid>
                                <TextBlock Text="播放列表" VerticalAlignment="Center" Tag="local:LocalizedTag(Text='播放列表', English='Playlists')" />
                                <FontIcon
                                    x:Name="PlaylistChevron"
                                    Glyph="&#xE70D;"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="PlaylistItems">
                            <Button
                                x:Name="DefaultPlaylistButton"
                                Style="{StaticResource SidebarPlaylistButtonStyle}"
                                Tag="default"
                                Click="SidebarNavButton_Click"
                                AutomationProperties.Name="默认列表">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                    <TextBlock Text="默认列表" FontSize="12" Tag="local:LocalizedTag(Text='默认列表', English='Default list')" />
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="CustomPlaylistsPanel" />
                            <Button
                                Tag="local:LocalizedTag(Text='添加播放列表', English='Add playlist')"
                                x:Name="AddPlaylistButton"
                                Style="{StaticResource SidebarAddPlaylistButtonStyle}"
                                Click="AddPlaylistButton_Click"
                                AutomationProperties.Name="添加播放列表">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="添加播放列表" FontSize="12" Tag="local:LocalizedTag(Text='添加播放列表', English='Add playlist')" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="0,8,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Button
                        x:Name="SettingsNavButton"
                        Style="{StaticResource SidebarNavButtonStyle}"
                        Tag="settings"
                        Click="SidebarNavButton_Click"
                        AutomationProperties.Name="设置">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Tag="local:LocalizedTag(Text='设置', English='Settings')" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid
            x:Name="MainWorkspace"
            Grid.Row="1"
            Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Playlist function bar -->
            <Border
                Grid.Row="0"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid Padding="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            Tag="local:LocalizedTag(Text='默认列表', English='Default list')"
                            x:Name="DefaultListTitleText"
                            Text="默认列表"
                            FontSize="22"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Tag="local:LocalizedTag(Text='0 首曲目')"
                            x:Name="QueueCountText"
                            Text="0 首曲目"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <Button
                            Tag="local:LocalizedTag(Text='导入音乐（Ctrl+O）', English='Import music (Ctrl+O)')"
                            x:Name="ImportButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ImportButton_Click"
                            ToolTipService.ToolTip="导入音乐（Ctrl+O）"
                            AutomationProperties.Name="导入音乐">
                            <FontIcon Glyph="&#xE710;" FontSize="15" />
                        </Button>
                        <AutoSuggestBox
                            Tag="local:LocalizedTag(Text='搜索', English='Search')"
                            x:Name="SearchBox"
                            Width="190"
                            Height="36"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            PlaceholderText="搜索"
                            Visibility="Collapsed"
                            TextChanged="SearchBox_TextChanged"
                            AutomationProperties.Name="搜索播放列表" />
                        <Button
                            Tag="local:LocalizedTag(Text='搜索', English='Search')"
                            x:Name="SearchButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SearchButton_Click"
                            ToolTipService.ToolTip="搜索"
                            AutomationProperties.Name="搜索">
                            <FontIcon Glyph="&#xE721;" FontSize="15" />
                        </Button>
                        <Button
                            Tag="local:LocalizedTag(Text='排序', English='Sort')"
                            x:Name="SortButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SortButton_Click"
                            ToolTipService.ToolTip="排序"
                            AutomationProperties.Name="排序">
                            <FontIcon Glyph="&#xE8CB;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Playlist surface -->
            <Border
                Grid.Row="1"
                Margin="20,0,20,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="18">
                <Grid
                    x:Name="QueueDropSurface"
                    AllowDrop="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ListView
                            Tag="local:LocalizedTag(Text='播放队列', English='Queue')"
                            x:Name="QueueList"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            SelectionMode="Single"
                            IsItemClickEnabled="False"
                            DoubleTapped="QueueList_DoubleTapped"
                            SelectionChanged="QueueList_SelectionChanged"
                            AutomationProperties.Name="播放队列">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="MinHeight" Value="68" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Grid
                                                    x:Name="ItemRoot"
                                                    Background="Transparent"
                                                    CornerRadius="10">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Selected">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerOverSelected">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="PressedSelected">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="HoverLayer"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.08" />
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetName="SelectionIndicator"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0.08" />
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border
                                                        x:Name="HoverLayer"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="10"
                                                        IsHitTestVisible="False"
                                                        Opacity="0" />

                                                    <Border
                                                        x:Name="SelectionIndicator"
                                                        Width="3"
                                                        Height="40"
                                                        Margin="5,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed"
                                                        Opacity="0" />

                                                    <ContentPresenter
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Padding="{TemplateBinding Padding}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Track">
                                    <Grid
                                        Padding="10,6"
                                        ColumnSpacing="10"
                                        Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                        AutomationProperties.HelpText="{x:Bind DetailsLine, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.ColumnSpan="4"
                                            Margin="-10,-6,-10,-6"
                                            CornerRadius="10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{x:Bind CurrentVisibility, Mode=OneWay}"
                                            IsHitTestVisible="False" />
                                        <Border
                                            Width="3"
                                            Height="40"
                                            Margin="-5,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind CurrentVisibility, Mode=OneWay}"
                                            IsHitTestVisible="False" />

                                        <Grid
                                            Grid.Column="0"
                                            Width="56"
                                            Height="56">
                                            <Border
                                                CornerRadius="10"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            <FontIcon
                                                Glyph="&#xE8D6;"
                                                FontSize="22"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                            <Border
                                                CornerRadius="10"
                                                Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}">
                                                <Border.Background>
                                                    <ImageBrush
                                                        ImageSource="{x:Bind Artwork, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind QueueTitle, Mode=OneWay}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Text="{x:Bind QueueSubtitle, Mode=OneWay}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="QueueActionsPanel"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                            <Button
                                                Tag="local:LocalizedTag(Text='播放', English='Play')"
                                                Style="{StaticResource QueueActionButtonStyle}"
                                                Click="QueuePlayButton_Click"
                                                ToolTipService.ToolTip="播放"
                                                AutomationProperties.Name="播放">
                                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource QueueActionButtonStyle}"
                                                Click="QueueFavoriteButton_Click"
                                                ToolTipService.ToolTip="{x:Bind FavoriteToolTip, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind FavoriteToolTip, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="13" />
                                            </Button>
                                            <Button
                                                Tag="local:LocalizedTag(Text='添加到播放列表', English='Add to playlist')"
                                                Style="{StaticResource QueueActionButtonStyle}"
                                                Click="QueueAddButton_Click"
                                                ToolTipService.ToolTip="添加到播放列表"
                                                AutomationProperties.Name="添加到播放列表">
                                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                            </Button>
                                            <Button
                                                Tag="local:LocalizedTag(Text='更多选项', English='More options')"
                                                Style="{StaticResource QueueActionButtonStyle}"
                                                Click="QueueMoreButton_Click"
                                                ToolTipService.ToolTip="更多选项"
                                                AutomationProperties.Name="更多选项">
                                                <FontIcon Glyph="&#xE712;" FontSize="13" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="3"
                                            Spacing="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind DurationText, Mode=OneWay}"
                                                FontSize="14"
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind FileInfoText, Mode=OneWay}"
                                                FontSize="11"
                                                HorizontalAlignment="Right"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyQueuePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="280">
                            <Border
                                Width="66"
                                Height="66"
                                CornerRadius="20"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xE8D6;"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <TextBlock
                                Tag="local:LocalizedTag(Text='队列还是空的', English='Your queue is empty')"
                                Text="队列还是空的"
                                FontSize="17"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Tag="local:LocalizedTag(Text='导入或直接拖入几首本地音乐，创建你的播放列表。', English='Import or drop a few local songs to build your playlist.')"
                                Text="导入或直接拖入几首本地音乐，创建你的播放列表。"
                                FontSize="12"
                                LineHeight="19"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                Tag="local:LocalizedTag(Text='导入音乐', English='Import music')"
                                x:Name="EmptyImportButton"
                                HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="EmptyImportButton_Click"
                                AutomationProperties.Name="导入音乐">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="导入音乐" FontSize="13" FontWeight="SemiBold" Tag="local:LocalizedTag(Text='导入音乐', English='Import music')" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            x:Name="NoSearchResultsPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            MaxWidth="280"
                            Visibility="Collapsed">
                            <FontIcon
                                Glyph="&#xE721;"
                                FontSize="34"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Tag="local:LocalizedTag(Text='没有匹配的曲目', English='No matching tracks')"
                                Text="没有匹配的曲目"
                                FontSize="16"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Tag="local:LocalizedTag(Text='换一个关键词，或清空搜索框恢复完整播放列表。', English='Try another keyword, or clear the search box to show everything.')"
                                Text="换一个关键词，或清空搜索框恢复完整播放列表。"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Playlist status/actions -->
                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,7,10,7">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    x:Name="ImportProgressRing"
                                    Width="14"
                                    Height="14"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    Tag="local:LocalizedTag(Text='就绪', English='Ready')"
                                    x:Name="StatusText"
                                    Text="就绪"
                                    FontSize="11"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    Tag="local:LocalizedTag(Text='移除选中曲目', English='Remove selected track')"
                                    x:Name="RemoveButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="False"
                                    Click="RemoveButton_Click"
                                    ToolTipService.ToolTip="移除选中曲目"
                                    AutomationProperties.Name="移除选中曲目">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                                <Button
                                    Tag="local:LocalizedTag(Text='清空播放队列', English='Clear queue')"
                                    x:Name="ClearButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="False"
                                    Click="ClearButton_Click"
                                    ToolTipService.ToolTip="清空播放队列"
                                    AutomationProperties.Name="清空队列">
                                    <FontIcon Glyph="&#xE894;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="DropOverlay"
                        Grid.RowSpan="2"
                        Margin="6"
                        Background="#337B61FF"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="14"
