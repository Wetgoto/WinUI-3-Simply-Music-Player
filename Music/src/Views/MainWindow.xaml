                            ToolTipService.ToolTip="更多选项"
                            AutomationProperties.Name="更多选项">
                            <FontIcon Glyph="&#xE712;" FontSize="17" />
                        </Button>
                    </Grid>

                    <Border
                        x:Name="FullControlsBorder"
                        Grid.Row="2"
                        Height="140"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Padding="18,10"
                        CornerRadius="14"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="FullCurrentTimeText"
                                    Text="0:00"
                                    FontSize="10"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Slider
                                    Tag="local:LocalizedTag(Text='播放进度', English='Playback progress')"
                                    x:Name="FullProgressSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    StepFrequency="1"
                                    IsThumbToolTipEnabled="False"
                                    IsEnabled="False"
                                    ValueChanged="FullProgressSlider_ValueChanged"
                                    AutomationProperties.Name="播放进度" />
                                <TextBlock
                                    x:Name="FullTotalTimeText"
                                    Grid.Column="2"
                                    Text="0:00"
                                    FontSize="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                                    <Button
                                        Tag="local:LocalizedTag(Text='循环播放：关闭', English='Repeat: off')"
                                        x:Name="FullRepeatButton"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        CornerRadius="17"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RepeatButton_Click"
                                        ToolTipService.ToolTip="循环播放：关闭"
                                        AutomationProperties.Name="循环播放">
                                        <Grid x:Name="FullRepeatGlyphHost">
                                            <FontIcon
                                                x:Name="FullRepeatIcon"
                                                Glyph="&#xE8EE;"
                                                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        Tag="local:LocalizedTag(Text='上一首', English='Previous')"
                                        x:Name="FullPreviousButton"
                                        Width="38"
                                        Height="38"
                                        Padding="0"
                                        CornerRadius="19"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="FullPreviousButton_Click"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="上一首"
                                        AutomationProperties.Name="上一首">
                                        <FontIcon Glyph="&#xE892;" FontSize="18" />
                                    </Button>

                                    <Button
                                        Tag="local:LocalizedTag(Text='播放 / 暂停', English='Play / Pause')"
                                        x:Name="FullPlayPauseButton"
                                        Width="48"
                                        Height="48"
                                        Padding="0"
                                        CornerRadius="24"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="FullPlayPauseButton_Click"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="播放 / 暂停"
                                        AutomationProperties.Name="播放或暂停">
                                        <FontIcon
                                            x:Name="FullPlayPauseIcon"
                                            Glyph="&#xE768;"
                                            FontSize="19"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Button>

                                    <Button
                                        Tag="local:LocalizedTag(Text='下一首', English='Next')"
                                        x:Name="FullNextButton"
                                        Width="38"
                                        Height="38"
                                        Padding="0"
                                        CornerRadius="19"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="FullNextButton_Click"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="下一首"
                                        AutomationProperties.Name="下一首">
                                        <FontIcon Glyph="&#xE893;" FontSize="18" />
                                    </Button>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <Slider
                                        Tag="local:LocalizedTag(Text='音量', English='Volume')"
                                        x:Name="FullVolumeSlider"
                                        Width="90"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="65"
                                        StepFrequency="5"
                                        TickFrequency="5"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="True"
                                        ValueChanged="FullVolumeSlider_ValueChanged"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="音量"
                                        AutomationProperties.Name="音量" />
                                    <Button
                                        Tag="local:LocalizedTag(Text='静音', English='Mute')"
                                        x:Name="FullVolumeButton"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="FullVolumeButton_Click"
                                        ToolTipService.ToolTip="静音"
                                        AutomationProperties.Name="静音">
                                        <FontIcon
                                            x:Name="FullVolumeIcon"
                                            Glyph="&#xE767;"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Reserved area for the next iteration -->
                <Border
                    Grid.Column="1"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1,0,0,0"
                    Background="Transparent" />
            </Grid>
        </Grid>

        <!-- Black transition surface between the main page and player page -->
        <Border
            x:Name="PageFadeOverlay"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Background="Black"
            Opacity="0"
            Visibility="Collapsed"
            IsHitTestVisible="False" />
    </Grid>
</Window>
