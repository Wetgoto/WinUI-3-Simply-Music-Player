                                Text="支持同时拖入多个音频文件"
                                FontSize="12"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>

            <!-- Player control bar -->
            <Border
                x:Name="PlayerBar"
                Grid.Row="2"
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10,20,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Clicking anywhere in the player bar opens the full player page -->
                    <Button
                        Tag="local:LocalizedTag(Text='打开播放页面', English='Open player page')"
                        x:Name="NowPlayingAreaButton"
                        Grid.ColumnSpan="2"
                        Margin="-14,-4"
                        Padding="14,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="14"
                        Click="NowPlayingAreaButton_Click"
                        ToolTipService.ToolTip="打开播放页面"
                        AutomationProperties.Name="打开播放页面">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <!-- Current cover -->
                            <Grid
                                x:Name="HeroCoverHost"
                                Width="72"
                                Height="72"
                                VerticalAlignment="Center">
                                <Border
                                    CornerRadius="12"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon
                                            x:Name="HeroArtPlaceholder"
                                            Glyph="&#xE8D6;"
                                            FontSize="28"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image
                                            x:Name="HeroArt"
                                            Stretch="UniformToFill"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border
                                    CornerRadius="12"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False" />
                            </Grid>

                            <!-- Current track information -->
                            <StackPanel
                                Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                                <ScrollViewer
                                    HorizontalScrollMode="Enabled"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    IsTabStop="False"
                                    AutomationProperties.HelpText="MarqueeScroll"
                                    SizeChanged="Marquee_SizeChanged">
                                    <TextBlock
                                        Tag="local:LocalizedTag(Text='未播放', English='Not playing')"
                                        x:Name="HeroTitle"
                                        Text="未播放"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap" />
                                </ScrollViewer>
                                <ScrollViewer
                                    HorizontalScrollMode="Enabled"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    IsTabStop="False"
                                    AutomationProperties.HelpText="MarqueeScroll"
                                    SizeChanged="Marquee_SizeChanged">
                                    <TextBlock
                                        Tag="local:LocalizedTag(Text='从播放列表选择一首歌曲', English='Pick a song from a playlist')"
                                        x:Name="HeroAlbum"
                                        Text="从播放列表选择一首歌曲"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="NoWrap" />
                                </ScrollViewer>
                                <TextBlock
                                    Tag="local:LocalizedTag(Text='准备就绪')"
                                    x:Name="NowStateText"
                                    Text="准备就绪"
                                    FontSize="10"
                                    Visibility="Collapsed"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Progress and transport controls -->
                    <Grid Grid.Column="1" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="CurrentTimeText"
                                Text="0:00"
                                FontSize="10"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Slider
                                Tag="local:LocalizedTag(Text='播放进度', English='Playback progress')"
                                x:Name="ProgressSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                StepFrequency="1"
                                IsThumbToolTipEnabled="False"
                                IsEnabled="False"
                                ValueChanged="ProgressSlider_ValueChanged"
                                AutomationProperties.Name="播放进度" />
                            <TextBlock
                                x:Name="TotalTimeText"
                                Grid.Column="2"
                                Text="0:00"
                                FontSize="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
