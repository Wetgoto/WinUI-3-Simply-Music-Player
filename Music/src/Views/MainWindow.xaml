                                Text="换一个关键词，或清空搜索框。"
                                FontSize="12"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
