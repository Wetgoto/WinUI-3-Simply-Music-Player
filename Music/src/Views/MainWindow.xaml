                                    AutomationProperties.Name="循环播放">
                                    <Grid x:Name="RepeatGlyphHost">
                                        <FontIcon
                                            x:Name="RepeatIcon"
                                            Glyph="&#xE8EE;"
                                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>

                                <Button
                                    Tag="local:LocalizedTag(Text='上一首', English='Previous')"
                                    x:Name="PreviousButton"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    CornerRadius="19"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PreviousButton_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="上一首"
                                    AutomationProperties.Name="上一首">
                                    <FontIcon Glyph="&#xE892;" FontSize="18" />
                                </Button>

                                <Button
                                    Tag="local:LocalizedTag(Text='播放 / 暂停', English='Play / Pause')"
                                    x:Name="PlayPauseButton"
                                    Width="48"
                                    Height="48"
                                    Padding="0"
                                    CornerRadius="24"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="PlayPauseButton_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="播放 / 暂停"
                                    AutomationProperties.Name="播放或暂停">
                                    <FontIcon
                                        x:Name="PlayPauseIcon"
                                        Glyph="&#xE768;"
                                        FontSize="19"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Button>

                                <Button
                                    Tag="local:LocalizedTag(Text='下一首', English='Next')"
                                    x:Name="NextButton"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    CornerRadius="19"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NextButton_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="下一首"
                                    AutomationProperties.Name="下一首">
                                    <FontIcon Glyph="&#xE893;" FontSize="18" />
                                </Button>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="7"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <Button
                                    Tag="local:LocalizedTag(Text='收藏', English='Favorite')"
                                    x:Name="BarFavoriteButton"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="BarFavoriteButton_Click"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="收藏"
                                    AutomationProperties.Name="收藏">
                                    <FontIcon
                                        x:Name="BarFavoriteIcon"
                                        Glyph="&#xE734;"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                                <Button
                                    Tag="local:LocalizedTag(Text='静音', English='Mute')"
                                    x:Name="VolumeButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="VolumeButton_Click"
                                    ToolTipService.ToolTip="静音"
                                    AutomationProperties.Name="静音">
                                    <FontIcon
                                        x:Name="VolumeIcon"
                                        Glyph="&#xE767;"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                                <Slider
                                    Tag="local:LocalizedTag(Text='音量', English='Volume')"
                                    x:Name="VolumeSlider"
                                    Width="92"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="65"
                                    StepFrequency="5"
                                    TickFrequency="5"
                                    SnapsTo="StepValues"
                                    IsThumbToolTipEnabled="True"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="音量"
                                    AutomationProperties.Name="音量" />
                                <TextBlock
                                    Tag="local:LocalizedTag(Text='当前音量', English='Current volume')"
                                    x:Name="VolumeValueText"
                                    Text="65"
                                    Width="22"
                                    FontSize="11"
                                    TextAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    AutomationProperties.Name="当前音量" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

