                            Width="36"
                            Height="36"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RecentClearButton_Click"
                            ToolTipService.ToolTip="清空最近的项目"
                            AutomationProperties.Name="清空最近的项目">
                            <FontIcon Glyph="&#xE74D;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Margin="20,12,20,16">
                <Border
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
